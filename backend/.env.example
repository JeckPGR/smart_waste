# =========================================================================
# SMART WASTE - BACKEND ENVIRONMENT CONFIGURATION
# =========================================================================

# SAKLAR 1: POSTGRESQL LOKAL (Development Offline)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartwaste?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/smartwaste?schema=public"

# SAKLAR 2: SUPABASE POSTGRESQL CLOUD (Online / Render Production)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# App & Port
PORT=3000
PUBLIC_URL="http://localhost:3000"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Machine Learning Service URL
# Lokal: http://localhost:8000
# Hugging Face Space: https://[username]-[space-name].hf.space
ML_API_URL="http://localhost:8000"

# Cloudflare R2 Object Storage
R2_BUCKET_NAME="smart-waste"
R2_PUBLIC_URL="https://pub-xxxx.r2.dev"
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
